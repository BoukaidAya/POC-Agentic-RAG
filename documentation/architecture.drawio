        <mxCell id="e9" value="peuple les droits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="B_seed" target="S_pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="lit les droits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=9;" edge="1" parent="1" source="S_pg" target="B_sync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="réécrit les droits d'accès" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="B_sync" target="S_os"><mxGeometry relative="1" as="geometry" /></mxCell>

