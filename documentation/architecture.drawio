        <mxCell id="C_agents" value="Routage par domaine&#10;identifie les domaines pertinents&#10;→ un agent par domaine autorisé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
