        </mxCell>
        <mxCell id="gC" value="4 · Requête en ligne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EA;strokeColor=#D79B00;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#7A5200;" vertex="1" parent="1">
          <mxGeometry x="20" y="545" width="1000" height="250" as="geometry" />
