        </mxCell>
        <mxCell id="C_rag" value="Traitement RAG&#10;• droits de l'utilisateur&#10;• recherche hybride filtrée&#10;• génération de la réponse sourcée" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="745" y="612" width="235" height="110" as="geometry" />
        </mxCell>

        <!-- ================= Notes ================= -->
        <mxCell id="Cfg" value="Configuration partagée&#10;• accès réseau (OpenSearch / PostgreSQL)&#10;• correspondance dossier → domaine + descriptions" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="815" width="500" height="72" as="geometry" />
        </mxCell>
        <mxCell id="Dock" value="Infrastructure Docker : conteneur applicatif Linux (traitements + API, contourne Smart App Control) · OpenSearch · PostgreSQL · Dashboards" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="815" width="660" height="72" as="geometry" />
