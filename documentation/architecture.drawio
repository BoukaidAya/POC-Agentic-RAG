          <mxGeometry x="20" y="352" width="560" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lblExt" value="Services externes / modèles" style="text;html=1;align=left;fontStyle=1;fontSize=13;fontColor=#8A2E2A;" vertex="1" parent="1">
