        <mxCell id="e13" value="question + utilisateur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="C_front" target="C_api"><mxGeometry relative="1" as="geometry" /></mxCell>
