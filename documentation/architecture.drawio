        <mxCell id="A_chunk" value="Découpage en chunks&#10;(adaptatif selon&#10;le type de document)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="94" width="150" height="66" as="geometry" />
        </mxCell>
        <mxCell id="A_embed" value="Calcul des embeddings&#10;BGE-M3 · 1024 dimensions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
