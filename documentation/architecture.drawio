        <!-- ================= 3 · Stockage ================= -->
        <mxCell id="S_os" value="OpenSearch — moteur de recherche&#10;lexicale (BM25) + vectorielle (kNN)&#10;recherche hybride&#10;droits d'accès par document" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
