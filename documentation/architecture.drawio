        <mxCell id="C_api" value="API HTTP du chatbot&#10;(point d'entrée des requêtes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
