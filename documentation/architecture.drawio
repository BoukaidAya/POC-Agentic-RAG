        <mxCell id="e15" value="par domaine autorisé" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="C_agents" target="C_rag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="routage (appel au LLM)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1" source="C_agents" target="X_claude"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="1 · droits de l'utilisateur" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="C_rag" target="S_pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="2 · recherche hybride filtrée par droits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="C_rag" target="S_os"><mxGeometry relative="1" as="geometry" /></mxCell>
