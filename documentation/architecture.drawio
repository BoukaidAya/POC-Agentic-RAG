        </mxCell>
        <mxCell id="S_pg" value="PostgreSQL — source de vérité des droits&#10;utilisateurs · groupes&#10;documents · droits document ↔ groupe" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
