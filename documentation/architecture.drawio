        <!-- ================= Arêtes : ingestion ================= -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="A_src" target="A_extract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="texte brut&#10;(par page)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="A_extract" target="A_clean"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="texte nettoyé&#10;(+ dossiers fusionnés)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="A_clean" target="A_chunk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="A_chunk" target="A_embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="chunks + vecteurs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="A_embed" target="A_bulk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="indexe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="A_bulk" target="S_os"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="encode les chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=9;" edge="1" parent="1" source="A_embed" target="X_bge"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ================= Arêtes : droits ================= -->
